#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/* Key positions for positional hold-tap (Bilateral Combinations) */
// All left hand keys (including left thumb cluster)

#define KEYS_L 0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67

// All right hand keys (including right thumb cluster)

#define KEYS_R 7 8 9 10 11 12 13 21 22 23 24 25 26 27 37 38 39 40 41 42 43 44 45 53 54 55 56 57 58 59 68 69 70 71 72 73 74 75

// Thumb keys (for exceptions, if needed)

#define THUMBS 35 36 52 65 66 67 37 38 53 68 69 70

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        // -----------------------------------------------------------------------------------------
        // 1. CONFIG FOR PINKIES: Keys A (LShift) and ; (RShift)
        // -----------------------------------------------------------------------------------------
        // Goal: Compensate for slow press and release.
        // Strategy: Maximum timing tolerance, strict positional filter.

        hm_l_pinky: home_row_mod_left_pinky {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>; // Increased to 300ms: pinky can "stick" without consequences
            quick-tap-ms = <175>; // Allows typing 'aa' quickly via double-tap
            require-prior-idle-ms = <150>; // Blocks Shift on fast rolls
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_R THUMBS>; // Shift will ONLY trigger in combination with the Right hand
        };

        hm_r_pinky: home_row_mod_right_pinky {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_L THUMBS>; // Shift will ONLY trigger in combination with the Left hand
        };

        // -----------------------------------------------------------------------------------------
        // 2. CONFIG FOR RING/MIDDLE FINGERS: S, D, L, K (Ctrl, Alt)
        // -----------------------------------------------------------------------------------------
        // Goal: Balance between speed and reliability.

        hm_l_ring: home_row_mod_left_ring {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>; // "Timeless" standard: 280ms
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>; // Slightly stricter than for pinky
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_R THUMBS>;
        };

        hm_r_ring: home_row_mod_right_ring {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_L THUMBS>;
        };

        // -----------------------------------------------------------------------------------------
        // 3. CONFIG FOR INDEX FINGERS: F, J (GUI/Meta)
        // -----------------------------------------------------------------------------------------
        // Goal: Instant reaction and prevention of misfires when rolling to the center (G, H).
        // Index fingers are the fastest, so idle timing must be aggressive.

        hm_l_index: home_row_mod_left_index {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>; // Reduced to 250ms: fast finger
            quick-tap-ms = <175>;
            require-prior-idle-ms = <100>; // Very strict filter: any active typing blocks the mod
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_R THUMBS>;
        };

        hm_r_index: home_row_mod_right_index {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_L THUMBS>;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&esc_en>;
            key-positions = <16 17>;
            layers = <0 1>;
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
        };

        d_quotes {
            bindings = <&kp LS(DOUBLE_QUOTES)>;
            key-positions = <48 49>;
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
        };

        s_quotes {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <57 56>;
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
        };

        lparen {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <23 24>;
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
        };

        lcurly {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <55 56>;
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
        };

        lbracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <49 50>;
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
        };
    };

    macros {
        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(N1))>;
        };

        esc_en: esc_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE &to_en>;
        };
    };

    // ════════════════════════════════════════════════════════════════════
    // Since 2026-08-18 this firmware is a QWERTY pass-through: every letter
    // binding names the PHYSICAL key position, and the OS renders Colemak-DH
    // Matrix on top (macOS: "Colemak DH Matrix" bundle; Dell: xkb
    // us(colemak_dh_ortho)). Russian is an OS concern too: Caps (left of A)
    // toggles the language on both OSes (xkb grp:caps_toggle on Dell, the
    // caps-switch option on macOS), while to_en/esc_en send Ctrl+Shift+1 as
    // the absolute return to EN (Kawa on macOS, switch-layout bind in niri).
    // The firmware holds no language state at all.
    //
    // To emit letter X, bind the physical key the OS maps to X — e.g. the
    // vim-style k/j in the keypad layer are physical N/Y.
    // ════════════════════════════════════════════════════════════════════

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";
            bindings = <
&kp EQUAL         &kp LS(N1)              &kp LS(N2)         &kp LS(N3)  &kp LS(N4)                  &kp LS(N5)  &none                                                                                         &mo 2              &kp LS(N6)  &kp LS(N7)                   &kp LS(N8)    &kp LS(N9)              &kp LS(N0)                       &kp MINUS
&kp TAB           &kp Q                   &kp W              &kp E       &kp R                       &kp T       &kp LA(LC(LEFT))                                                                              &kp LA(LC(RIGHT))  &kp Y       &kp U                        &kp I         &kp O                   &kp P                            &kp BSLH
&kp CAPS          &hm_l_pinky LEFT_ALT A  &hm_l_ring LGUI S  &kp D       &hm_l_index LEFT_CONTROL F  &kp G       &kp LA(LC(R))     &kp LEFT_GUI  &kp LEFT_ALT              &kp LG(SPACE)     &kp LEFT_CONTROL  &kp LA(LC(ENTER))  &kp H       &hm_r_index RIGHT_CONTROL J  &kp K         &hm_r_ring RIGHT_GUI L  &hm_r_pinky RIGHT_ALT SEMICOLON  &kp SQT
&kp LEFT_SHIFT    &kp Z                   &kp X              &kp C       &kp V                       &kp B                                       &kp LG(LEFT_CONTROL)      &kp LC(LEFT_ALT)                                       &kp N       &kp M                        &kp COMMA     &kp DOT                 &kp FSLH                         &kp RIGHT_SHIFT
&kp LG(NUMBER_1)  &kp GRAVE               &kp CAPS           &kp LEFT    &kp RIGHT                               &kp SPACE         &mo 1         &kp LG(T)                 &kp LG(ENTER)     &kp ENTER         &kp BACKSPACE                  &kp DOWN_ARROW               &kp UP_ARROW  &kp LBKT                &kp RBKT                         &kp LA(F12)
            >;
        };

        keypad {
            display-name = "kp";
            bindings = <
&trans  &trans  &trans     &trans  &trans      &trans  &trans                                                 &trans  &trans     &trans  &trans  &trans   &trans     &trans
&trans  &trans  &trans     &trans  &trans      &trans  &trans                                                 &trans  &kp LS(G)  &kp N7  &kp N8  &kp N9   &kp MINUS  &trans
&trans  &trans  &kp CARET  &trans  &kp DOLLAR  &trans  &trans  &trans  &trans      &trans  &trans             &trans  &kp N      &kp N4  &kp N5  &kp N6   &kp PLUS   &trans
&trans  &trans  &trans     &trans  &trans      &trans                  &trans      &trans                             &kp Y      &kp N1  &kp N2  &kp N3   &trans     &trans
&trans  &trans  &trans     &trans  &trans              &trans  &trans  &trans      &trans  &kp LS(SEMICOLON)  &kp N0             &trans  &trans  &kp DOT  &trans     &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none             &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none             &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock    &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none             &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&kp LG(NUMBER_1)  &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
