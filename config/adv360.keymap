#include <dt-bindings/zmk/stp.h>
#include <behaviors/num_word.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&lt { tapping-term-ms = <130>; };

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 46 47 48 49 50 51 60 61 62 63 64>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75>;
        };

        sl_num_kp: sl_num_kp {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <LEFT DOWN UP RIGHT BSPC DEL KP_DOT DOT COMMA MINUS UNDER GRAVE LEFT_PARENTHESIS EQUAL RIGHT_PARENTHESIS QMARK HASH CARET LBRC DOLLAR RIGHT_BRACE STAR LT PIPE GT COLON>;
            ignore-modifiers;
            ignore-numbers;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&esc_en>;
            key-positions = <16 17>;
            layers = <0 1>;
        };

        tmux {
            bindings = <&kp LC(B)>;
            key-positions = <24 25>;
            layers = <0 1>;
        };

        d_quotes {
            bindings = <&kp LS(DOUBLE_QUOTES)>;
            key-positions = <48 49>;
        };

        s_quotes {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <57 56>;
        };
    };

    macros {
        code_md: code_md {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp GRAVE &kp GRAVE &kp LA(RET) &kp LG(V) &kp LA(ENTER) &kp GRAVE &kp GRAVE &kp GRAVE>;
            label = "CODE_MD";
        };

        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &kp LC(LS(N2))>;
            label = "TO_RU";
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LC(LS(N1))>;
            label = "TO_EN";
        };

        esc_en: esc_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE &to_en>;
            label = "ESC_EN";
        };

        keypad_en: keypad_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_en &mo 2>;
            label = "KEYPAD_EN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            display-name = "en";
            bindings = <
&kp EQUAL         &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp PRCNT  &tog 2                                                                           &mo 5              &kp LS(N6)  &kp LS(N7)    &kp LS(N8)            &kp LS(N9)        &kp LS(N0)     &kp MINUS
&kp TAB           &kp Q       &kp W       &kp F       &kp P       &kp B      &kp LA(LC(LEFT))                                                                 &kp LA(LC(RIGHT))  &kp J       &kp L         &kp U                 &kp Y             &kp SEMICOLON  &kp BSLH
&to_ru            &kp A       &kp R       &kp S       &kp T       &kp G      &kp LA(LC(R))     &kp LEFT_META  &kp LALT      &kp RIGHT_META  &kp LEFT_CONTROL  &kp LA(LC(ENTER))  &kp M       &kp N         &hmr RIGHT_CONTROL E  &hmr RIGHT_ALT I  &kp O          &kp SQT
&sk LEFT_SHIFT    &kp Z       &kp X       &kp C       &kp D       &kp V                                       &kp HOME      &kp PG_UP                                            &kp K       &kp H         &kp COMMA             &kp DOT           &kp FSLH       &kp RSHFT
&kp LG(NUMBER_1)  &kp GRAVE   &caps_word  &kp LEFT    &kp RIGHT              &kp SPACE         &keypad_en     &kp END       &kp PG_DN       &lt 3 ENTER       &kp BACKSPACE                  &kp UP_ARROW  &kp DOWN_ARROW        &kp LBKT          &kp RBKT       &kp LA(F12)
            >;
        };

        ru {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans     &trans   &trans    &trans
&trans  &kp Q   &kp W   &kp E   &kp R   &kp T   &trans                                      &trans  &kp Y   &kp U   &kp I      &kp O    &kp P     &trans
&to_en  &kp A   &kp S   &kp D   &kp F   &kp G   &trans  &trans  &trans      &trans  &trans  &trans  &kp H   &kp J   &kp K      &kp L    &kp SEMI  &trans
&trans  &kp Z   &kp X   &kp C   &kp V   &kp B                   &trans      &trans                  &kp N   &kp M   &kp COMMA  &kp DOT  &trans    &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans     &trans   &trans    &trans
            >;
        };

        keypad {
            display-name = "kp";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans     &trans     &trans     &trans     &trans      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans     &kp LS(G)  &kp KP_N7  &kp KP_N8  &kp KP_N9   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans     &kp K      &kp KP_N4  &kp KP_N5  &kp KP_N6   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                     &kp J      &kp KP_N1  &kp KP_N2  &kp KP_N3   &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &none   &trans      &trans  &trans  &kp KP_N0             &trans     &trans     &kp KP_DOT  &trans  &trans
            >;
        };

        sym {
            display-name = "sym";
            bindings = <
&trans  &trans     &trans     &trans     &trans     &trans     &trans                                      &trans  &trans  &trans     &trans     &trans  &trans      &trans
&trans  &kp EXCL   &kp TILDE  &kp BSLH   &kp AMPS   &kp DLLR   &trans                                      &trans  &trans  &trans     &kp LC(U)  &trans  &trans      &trans
&trans  &kp UNDER  &kp MINUS  &kp PLUS   &kp EQUAL  &kp PIPE   &trans  &trans  &trans      &trans  &trans  &trans  &kp H   &kp J      &kp K      &kp L   &kp DELETE  &trans
&trans  &kp LT     &kp GT     &kp COLON  &kp SEMI   &kp QMARK                  &trans      &trans                  &trans  &kp LC(D)  &trans     &trans  &trans      &trans
&trans  &trans     &trans     &trans     &trans                &trans  &trans  &trans      &trans  &none   &trans          &trans     &trans     &trans  &trans      &trans
            >;
        };

        apps {
            bindings = <
&trans  &trans                 &trans  &trans  &trans                 &trans                 &trans                                      &trans  &trans                        &trans             &trans  &trans        &trans  &trans
&trans  &trans                 &trans  &trans  &kp LS(LA(LC(LG(P))))  &kp LS(LA(LC(LG(B))))  &trans                                      &trans  &trans                        &trans             &trans  &trans        &trans  &trans
&trans  &kp LS(LA(LC(LG(A))))  &trans  &trans  &trans                 &kp LS(LA(LC(LG(G))))  &trans  &trans  &trans      &trans  &trans  &trans  &kp LS(LC(LG(LA(M))))         &kp C_VOLUME_DOWN  &trans  &kp C_VOL_UP  &trans  &trans
&trans  &kp LS(LA(LC(LG(Z))))  &trans  &trans  &kp LS(LA(LC(LG(D))))  &trans                                 &trans      &trans                  &kp LS(LG(LA(LC(NUMBER_3))))  &trans             &trans  &trans        &trans  &trans
&trans  &trans                 &trans  &trans  &trans                                        &trans  &trans  &trans      &trans  &trans  &trans                                &trans             &trans  &trans        &trans  &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        apps {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };
};
