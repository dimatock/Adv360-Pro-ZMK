#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 46 47 48 49 50 51 60 61 62 63 64>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75>;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&esc_en>;
            key-positions = <16 17>;
            layers = <0 1>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <43 42>;
            layers = <0 1>;
        };
    };

    macros {
        select_word: select_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LEFT_ARROW) &kp LA(LS(RIGHT))>;
            label = "SELECT_WORD";
        };

        code_md: code_md {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp GRAVE &kp GRAVE &kp LA(RET) &kp LG(V) &kp GRAVE &kp GRAVE &kp GRAVE>;
            label = "CODE_MD";
        };

        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &kp LC(LS(N2))>;
            label = "TO_RU";
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LC(LS(N1))>;
            label = "TO_EN";
        };

        esc_en: esc_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE &to_en>;
            label = "ESC_EN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            display-name = "en";
            bindings = <
&kp EQUAL   &kp LS(N1)           &kp LS(N2)       &kp LS(N3)        &kp LS(N4)         &kp LS(N5)  &tog 2                                                                       &mo 4            &kp LS(N6)  &kp LS(N7)         &kp LS(N8)        &kp LS(N9)        &kp LS(N0)            &kp MINUS
&kp TAB     &kp Q                &kp W            &kp F             &kp P              &kp B       &none                                                                        &none            &kp J       &kp L              &kp U             &kp Y             &kp SEMICOLON         &kp BSLH
&to_ru      &hml LEFT_CONTROL A  &hml LEFT_ALT R  &hml LEFT_META S  &hml LEFT_SHIFT T  &kp G       &none        &kp LCTRL                   &kp LALT      &kp LGUI   &kp RCTRL  &none            &kp M       &hmr LEFT_SHIFT N  &hmr LEFT_META E  &hmr RIGHT_ALT I  &hmr RIGHT_CONTROL O  &kp SQT
&caps_word  &kp Z                &kp X            &kp C             &kp D              &kp V                                                &kp HOME      &kp PG_UP                              &kp K       &kp H              &kp COMMA         &kp DOT           &kp FSLH              &kp RSHFT
&mo 3       &kp GRAVE            &kp CAPS         &kp LEFT          &kp RIGHT                      &lt 2 SPACE  &kp LA(LC(LG(LEFT_SHIFT)))  &kp END       &kp PG_DN  &kp ENTER  &lt 3 BACKSPACE              &kp UP             &kp DOWN          &kp LBKT          &kp RBKT              &mo 3
            >;
        };

        ru {
            bindings = <
&trans  &trans        &trans           &trans           &trans             &trans  &trans                                      &trans  &trans  &trans              &trans            &trans            &trans                   &trans
&trans  &kp Q         &kp W            &kp E            &kp R              &kp T   &trans                                      &trans  &kp Y   &kp U               &kp I             &kp O             &kp P                    &kp BSLH
&to_en  &hml LCTRL A  &hml LEFT_ALT S  &hml LEFT_GUI D  &hml LEFT_SHIFT F  &kp G   &trans  &trans  &trans      &trans  &trans  &trans  &kp H   &hmr RIGHT_SHIFT J  &hmr RIGHT_GUI K  &hmr RIGHT_ALT L  &hmr RIGHT_CONTROL SEMI  &kp APOS
&trans  &kp Z         &kp X            &kp C            &kp V              &kp B                   &trans      &trans                  &kp N   &kp M               &kp COMMA         &kp DOT           &kp FSLH                 &trans
&trans  &kp GRAVE     &trans           &trans           &trans                     &trans  &trans  &trans      &trans  &trans  &trans          &trans              &trans            &kp LBKT          &kp RBKT                 &trans
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                          &mo 4      &kp TILDE  &kp CARET  &kp HASH   &kp DOLLAR  &kp EXCLAMATION  &kp AT
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                           &none      &kp LS(G)  &kp KP_N7  &kp KP_N8  &kp KP_N9   &kp COLON        &kp PRCNT
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none   &none  &none      &none      &kp EQUAL  &none      &kp K      &kp KP_N4  &kp KP_N5  &kp KP_N6   &kp MINUS        &kp PLUS
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                  &none      &none                            &kp J      &kp KP_N1  &kp KP_N2  &kp KP_N3   &kp SLASH        &kp STAR
&mo 3      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &none   &none  &none      &kp COMMA  &kp DOT    &kp KP_N0             &kp UP     &kp DOWN   &kp KP_DOT  &kp RBKT         &kp PIPE
            >;
        };

        sym {
            display-name = "sym";
            bindings = <
&kp F1    &kp F2            &kp F3                &kp F4                 &kp F5             &kp F6     &tog 2                                            &mo 4   &kp F7  &kp F8  &kp F9    &kp F10  &kp F11  &kp F12
&kp EXCL  &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp QMARK  &none                                             &none   &trans  &trans  &trans    &trans   &trans   &trans
&kp HASH  &kp COMMA         &kp LBRC              &kp RBRC               &kp SEMI           &kp STAR   &none      &trans     &trans      &trans  &trans  &none   &trans  &trans  &code_md  &trans   &trans   &trans
&trans    &kp CARET         &kp EQUAL             &kp UNDER              &kp DOLLAR         &kp SLASH                        &trans      &trans                  &trans  &trans  &trans    &trans   &trans   &trans
&trans    &kp LT            &kp PIPE              &kp MINUS              &kp GT                        &kp PRCNT  &kp COLON  &trans      &trans  &trans  &trans          &trans  &trans    &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
