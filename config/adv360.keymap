#include <dt-bindings/zmk/stp.h>
#include <behaviors/num_word.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

// Все клавиши левой руки (включая левый кластер больших пальцев)
#define KEYS_L 0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67
// Все клавиши правой руки (включая правый кластер больших пальцев)
#define KEYS_R 7 8 9 10 11 12 13 21 22 23 24 25 26 27 37 38 39 40 41 42 43 44 45 53 54 55 56 57 58 59 68 69 70 71 72 73 74 75
// Клавиши больших пальцев (для исключений, если необходимо)
#define THUMBS 35 36 52 65 66 67 37 38 53 68 69 70

&lt { tapping-term-ms = <130>; };

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        // -----------------------------------------------------------------------------------------
        // 1. КОНФИГУРАЦИЯ ДЛЯ МИЗИНЦЕВ (PINKY): Клавиши A (LShift) и ; (RShift)
        // -----------------------------------------------------------------------------------------
        // Цель: Компенсация медленного нажатия и отпускания.
        // Стратегия: Максимальная толерантность к таймингу, жесткий позиционный фильтр.
        hm_l_pinky: home_row_mod_left_pinky {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_L_PINKY";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>; // Увеличено до 300мс: мизинец может "залипать" без последствий
            quick-tap-ms = <175>; // Позволяет быстро напечатать 'aa' через double-tap
            require-prior-idle-ms = <150>; // Блокирует Shift, если вы печатаете очень быстро (rolling)
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>; // Сработает Shift ТОЛЬКО в комбинации с Правой рукой
            hold-trigger-on-release; // Ждать отпускания: критично для flavor="balanced"
        };
        hm_r_pinky: home_row_mod_right_pinky {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_R_PINKY";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>; // Сработает Shift ТОЛЬКО в комбинации с Левой рукой
            hold-trigger-on-release;
        };
        // -----------------------------------------------------------------------------------------
        // 2. КОНФИГУРАЦИЯ ДЛЯ БЕЗЫМЯННЫХ И СРЕДНИХ (RING/MIDDLE): S, D, L, K (Ctrl, Alt)
        // -----------------------------------------------------------------------------------------
        // Цель: Баланс между скоростью и надежностью.
        hm_l_ring: home_row_mod_left_ring {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_L_RING";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>; // Стандарт "Timeless": 280мс
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>; // Чуть строже, чем для мизинца
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };
        hm_r_ring: home_row_mod_right_ring {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_R_RING";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
        // -----------------------------------------------------------------------------------------
        // 3. КОНФИГУРАЦИЯ ДЛЯ УКАЗАТЕЛЬНЫХ (INDEX): F, J (GUI/Meta)
        // -----------------------------------------------------------------------------------------
        // Цель: Мгновенная реакция и предотвращение ложных срабатываний при перекатах в центр (G, H).
        // Указательные пальцы самые быстрые, поэтому тайминг idle должен быть агрессивным.
        hm_l_index: home_row_mod_left_index {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_L_INDEX";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>; // Снижено до 250мс: палец быстрый
            quick-tap-ms = <175>;
            require-prior-idle-ms = <100>; // Очень строгий фильтр: любое активное печатание блокирует мод
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };
        hm_r_index: home_row_mod_right_index {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_R_INDEX";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&esc_en>;
            key-positions = <16 17>;
            layers = <0 1 2>;
        };

        d_quotes {
            bindings = <&kp LS(DOUBLE_QUOTES)>;
            key-positions = <48 49>;
        };

        s_quotes {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <57 56>;
        };

        lparen {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <23 24>;
        };

        lcurly {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <55 56>;
        };

        lbracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <49 50>;
        };
    };

    macros {
        code_md: code_md {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_en &kp GRAVE &kp GRAVE &kp GRAVE &kp LS(RET) &kp LG(V) &kp LS(ENTER) &kp GRAVE &kp GRAVE &kp GRAVE>;
            label = "CODE_MD";
        };

        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &kp LC(LS(N2))>;
            label = "TO_RU";
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LC(LS(N1))>;
            label = "TO_EN";
        };

        esc_en: esc_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE &to_en>;
            label = "ESC_EN";
        };

        sym_en: sym_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_en &to 3>;
            label = "SYM_EN";
        };

        to_en_kp: to_en_kp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to_en &kp LC(LS(NUMBER_1)) &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_EN_KP";
        };

        toggle_tap: toggle_tap {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings = <&macro_param_1to1 &tog MACRO_PLACEHOLDER &macro_param_2to1 &kp MACRO_PLACEHOLDER>;
            label = "TOGGLE_TAP";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            display-name = "en";
            bindings = <
&kp EQUAL         &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp PRCNT  &tog 6                                                                                              &mo 5              &kp LS(N6)  &kp LS(N7)      &kp LS(N8)    &kp LS(N9)  &kp LS(N0)     &kp MINUS
&kp TAB           &kp Q       &kp W       &kp F       &kp P       &kp B      &kp LA(LC(LEFT))                                                                                    &kp LA(LC(RIGHT))  &kp J       &kp L           &kp U         &kp Y       &kp SEMICOLON  &kp BSLH
&to_ru            &hm_l_pinky LSHFT A &hm_l_ring LCTRL R &hm_l_ring LALT S &hm_l_index LGUI T &kp G      &kp LA(LC(R))     &kp LEFT_GUI  &kp LEFT_ALT               &kp LG(SPACE)          &kp LEFT_CONTROL  &kp LA(LC(ENTER))  &hm_r_index RGUI M &hm_r_ring RALT N &hm_r_ring RCTRL E &hm_r_pinky RSHFT I &kp O &kp SQT
&sk LEFT_SHIFT    &kp Z       &kp X       &kp C       &kp D       &kp V                                      &kp LG(LEFT_CONTROL)       &kp LC(LEFT_ALT)                                            &kp K       &kp H           &kp COMMA     &kp DOT     &kp FSLH       &toggle_tap 7 LEFT_ALT
&kp LG(NUMBER_1)  &kp GRAVE   &kp CAPS    &kp LEFT    &kp RIGHT              &kp SPACE         &mo 2         &kp LS(LA(LC(LG(B))))      &kp LS(LA(LC(LG(A))))  &lt 3 ENTER       &kp BACKSPACE                  &kp DOWN_ARROW  &kp UP_ARROW  &kp LBKT    &kp RBKT       &kp LA(F12)
            >;
        };

        ru {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                &trans  &trans  &trans  &trans     &trans   &trans    &trans
&trans  &kp Q   &kp W   &kp E   &kp R   &kp T   &trans                                                &trans  &kp Y   &kp U   &kp I      &kp O    &kp P     &trans
&to_en  &kp A   &kp S   &kp D   &kp F   &kp G   &trans  &trans  &trans         &trans         &trans  &trans  &kp H   &kp J   &kp K      &kp L    &kp SEMI  &trans
&trans  &kp Z   &kp X   &kp C   &kp V   &kp B                   &trans         &trans                         &kp N   &kp M   &kp COMMA  &kp DOT  &trans    &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &kp SLASH      &kp LS(SLASH)  &trans  &trans          &trans  &trans     &trans   &trans    &trans
            >;
        };

        keypad {
            display-name = "kp";
            bindings = <
&trans  &trans  &trans     &trans  &trans      &trans  &trans                                      &trans  &trans     &trans  &trans  &trans   &trans     &trans
&trans  &trans  &trans     &trans  &trans      &trans  &trans                                      &trans  &kp LS(G)  &kp N7  &kp N8  &kp N9   &kp MINUS  &trans
&trans  &trans  &kp CARET  &trans  &kp DOLLAR  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &kp K      &kp N4  &kp N5  &kp N6   &kp PLUS   &trans
&trans  &trans  &trans     &trans  &trans      &trans                  &trans      &trans                  &kp J      &kp N1  &kp N2  &kp N3   &trans     &trans
&trans  &trans  &trans     &trans  &trans              &trans  &tog 2  &trans      &trans  &trans  &kp N0             &trans  &trans  &kp DOT  &trans     &trans
            >;
        };

        sym {
            display-name = "sym";
            bindings = <
&trans     &trans            &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans             &trans         &trans                                                                             &trans  &trans             &trans   &trans  &trans  &trans     &trans
&trans     &kp LEFT_BRACKET  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp RIGHT_BRACKET  &kp SEMICOLON  &trans                                                                             &trans  &trans             &trans   &trans  &trans  &trans     &trans
&trans     &kp CARET         &kp EQUAL             &kp UNDER              &kp DOLLAR         &trans         &trans               &kp BACKSLASH        &trans      &trans  &trans               &trans  &kp DOUBLE_QUOTES  &kp TAB  &trans  &trans  &kp ENTER  &trans
&kp TILDE  &kp LESS_THAN     &kp PIPE              &kp MINUS              &kp GREATER_THAN   &kp SLASH                                                &trans      &trans                               &kp SQT            &trans   &trans  &trans  &trans     &tog 3
&trans     &trans            &trans                &trans                 &trans                            &toggle_tap 3 SPACE  &toggle_tap 3 COLON  &trans      &trans  &toggle_tap 3 ENTER  &trans                     &trans   &trans  &trans  &trans     &trans
            >;
        };

        apps {
            bindings = <
&trans  &trans                 &trans  &trans  &trans                 &trans                 &trans                                      &trans  &trans                        &trans             &trans  &trans                 &trans  &trans
&trans  &trans                 &trans  &trans  &kp LS(LA(LC(LG(P))))  &kp LS(LA(LC(LG(B))))  &trans                                      &trans  &trans                        &trans             &trans  &kp LS(LA(LC(LG(Y))))  &trans  &trans
&trans  &kp LS(LA(LC(LG(A))))  &trans  &trans  &trans                 &kp LS(LA(LC(LG(G))))  &trans  &trans  &trans      &trans  &trans  &trans  &kp LS(LC(LG(LA(M))))         &kp C_VOLUME_DOWN  &trans  &kp C_VOL_UP           &trans  &trans
&trans  &kp LS(LA(LC(LG(Z))))  &trans  &trans  &kp LS(LA(LC(LG(D))))  &trans                                 &trans      &trans                  &kp LS(LG(LA(LC(NUMBER_3))))  &trans             &trans  &trans                 &trans  &trans
&trans  &trans                 &trans  &trans  &trans                                        &trans  &trans  &trans      &trans  &trans  &trans                                &trans             &trans  &trans                 &trans  &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&kp LG(NUMBER_1)           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        game {
            bindings = <
&trans  &kp N1  &kp N2        &kp N3    &kp N4     &kp N5  &kp N6                                                    &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS  &kp EQUAL  &trans
&trans  &trans  &kp NUMBER_1  &kp UP    &kp E      &kp R   &kp NUMBER_7                                              &trans  &trans  &trans  &trans  &trans     &trans     &trans
&trans  &trans  &kp LEFT      &kp DOWN  &kp RIGHT  &kp M   &kp NUMBER_8  &trans          &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans
&trans  &trans  &trans        &trans    &kp F      &trans                                &trans      &trans                  &trans  &trans  &trans  &trans     &trans     &trans
&trans  &trans  &trans        &trans    &trans             &kp SPACE     &kp LEFT_SHIFT  &trans      &trans  &trans  &trans          &trans  &trans  &trans     &trans     &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                            &trans  &trans  &trans  &trans     &trans   &trans    &trans
&trans  &kp Q   &kp W   &kp E   &kp R   &kp T   &trans                                            &trans  &kp Y   &kp U   &kp I      &kp O    &kp P     &kp BSLH
&trans  &kp A   &kp S   &kp D   &kp F   &kp G   &trans     &trans     &trans      &trans  &trans  &trans  &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp APOS
&trans  &kp Z   &kp X   &kp C   &kp V   &kp B                         &trans      &trans                  &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &toggle_tap 7 LEFT_ALT
&trans  &trans  &trans  &trans  &trans          &mkp LCLK  &mkp RCLK  &trans      &trans  &trans  &trans          &trans  &trans     &trans   &trans    &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        apps {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };
};
